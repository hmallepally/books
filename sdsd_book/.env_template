# SDSD-CLI Environment Variables

# ==========================================
# Build Tool Paths (Optional - Auto-detected if in system PATH)
# ==========================================
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk
# MAVEN_HOME=/opt/maven
# GRADLE_HOME=/opt/gradle
# PYTHON_PATH=/usr/bin/python3
# DOTNET_ROOT=/usr/share/dotnet

# ==========================================
# API Configuration for SDSD Validation Engine
# ==========================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
# SDSD_TELEMETRY_ENABLED=true

# ==========================================
# Testing Framework Overrides
# ==========================================
# To force a specific test framework, uncomment one:
# SDSD_TEST_FRAMEWORK=pytest
# SDSD_TEST_FRAMEWORK=maven
# SDSD_TEST_FRAMEWORK=gradle
# SDSD_TEST_FRAMEWORK=dotnet
